# Usually generated by: bash run.sh setup
# Empty = city from IPinfo, labelled '(по IP)' in reports. Manual value wins.
LC_AGENT_CITY=''
# Empty = actual host name + OS + best-effort outbound network from IPinfo.
LC_AGENT_NAME=''
# IPinfo sees your public IP, but no device name/secrets. Set false to disable.
# LC_AUTO_NETWORK='false'
# LC_AUTO_CITY='false'
LC_TELEGRAM_CHAT_ID='-5361201677'
LC_TELEGRAM_BOT_TOKEN_FILE='/run/secrets/telegram_bot_token'
# Telegram-only proxy: run.sh automatically mounts secrets/telegram_proxy_url when present.
# LC_TELEGRAM_PROXY_URL_FILE='/run/secrets/telegram_proxy_url'
LC_SUBSCRIPTION_URL_FILE='/run/secrets/subscription_url'
LC_STATE_DIR='/var/lib/litechecker'
LC_INTERVAL_SECONDS='600'
# ID is automatically created and kept in state/standalone/device.json.
# Optional, only before the first run: LC_AGENT_ID='moscow-ivan-home'
