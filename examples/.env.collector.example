LC_AGENTS_REGISTRY_PATH=/run/secrets/agents.json
LC_DATABASE_PATH=/var/lib/litechecker/collector.sqlite3
LC_TELEGRAM_BOT_TOKEN_FILE=/run/secrets/telegram_bot_token
# Optional Telegram-only proxy; mount this additional secret read-only in collector.
# LC_TELEGRAM_PROXY_URL_FILE=/run/secrets/telegram_proxy_url
LC_TELEGRAM_CHAT_ID=REPLACE_WITH_CHAT_ID
LC_OFFLINE_THRESHOLD_SECONDS=1500
LC_REPORT_BURST=3
LC_REPORT_WINDOW_SECONDS=60
LC_EVENT_RETENTION_SECONDS=2592000
LC_MAX_EVENTS_PER_AGENT=5000
LC_COMPLETED_NOTIFICATION_RETENTION_SECONDS=604800
LC_MAX_COMPLETED_NOTIFICATIONS=5000
LC_MAX_DEAD_LETTERS_PER_AGENT=100
LC_MAX_PENDING_NOTIFICATIONS_PER_AGENT=100
LC_MAX_PENDING_NOTIFICATIONS_GLOBAL=10000
LC_MAX_PENDING_CHUNKS_PER_AGENT=1000
LC_MAX_PENDING_CHUNKS_GLOBAL=100000
LC_BIND_HOST=0.0.0.0
LC_BIND_PORT=8000
